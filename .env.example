# ============================================================
# GenZ IITian Connect — Environment Variables Template
# Copy to .env.local for local dev. NEVER commit .env.local.
# In production, set these in Vercel (web) and Fly.io (socket).
# ============================================================

# ── App ──
NEXT_PUBLIC_APP_NAME="GenZ IITian Connect"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Supabase (public client config) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (SECRET — server-side only, bypasses RLS) ──
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ──
ADMIN_ALLOWED_EMAILS=

# ── Razorpay (SECRET) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Compliance contacts ──
GRIEVANCE_OFFICER_EMAIL=
PRIVACY_CONTACT_EMAIL=
